# keybind = alt+h=goto_split:left
# keybind = alt+j=goto_split:bottom
# keybind = alt+k=goto_split:top
# keybind = alt+l=goto_split:right

# keybind = ctrl+alt+h=new_split:left
# keybind = ctrl+alt+j=new_split:down
# keybind = ctrl+alt+k=new_split:up
# keybind = ctrl+alt+l=new_split:right

theme = Gruvbox Material
background-opacity = 1
gtk-titlebar = false
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m

window-padding-x = 4
window-padding-y = 3
window-padding-balance = true

# tmux reattach to an existing session
# -A: Behave like attach-session if the session name exists.
# -s main: Names the default session "main".
# command = tmux new-session -A -s main
# each new window gets it's own session
command = "tmux new-session -A -s $(date +%s)"
